# Copy to .env in the repository root and replace both password placeholders.
APP_ENV=development
POSTGRES_PASSWORD=replace-with-a-local-random-password
DATABASE_URL=postgresql+psycopg://aos:replace-with-a-local-random-password@127.0.0.1:55432/aos
# Server-only variable: never use a NEXT_PUBLIC_ prefix for backend configuration.
API_BASE_URL=http://127.0.0.1:8000

