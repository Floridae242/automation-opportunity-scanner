{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "process.schema.json",
  "title": "ExtractedProcessDraft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "trigger",
    "outcome",
    "steps",
    "open_questions"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "trigger": {
      "type": [
        "string",
        "null"
      ]
    },
    "outcome": {
      "type": [
        "string",
        "null"
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "process_step.schema.json"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
