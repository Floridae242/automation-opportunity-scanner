{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analysis_result.schema.json",
  "title": "AnalysisResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pain_points",
    "opportunities",
    "missing_information"
  ],
  "properties": {
    "pain_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "category",
          "description",
          "step_keys",
          "evidence_refs",
          "confidence"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "step_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "opportunities": {
      "type": "array",
      "items": {
        "$ref": "opportunity.schema.json"
      }
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
