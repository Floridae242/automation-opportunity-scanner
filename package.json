{
  "name": "automation-opportunity-scanner",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=24 <25" },
  "packageManager": "npm@11.17.0",
  "workspaces": ["apps/web"],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "dev:api": "apps/api/.venv/bin/uvicorn aos_api.main:create_app --factory --host 127.0.0.1 --port 8000 --reload",
    "db:up": "docker compose --env-file .env -f infra/compose.local.yaml up -d --wait",
    "db:stop": "docker compose --env-file .env -f infra/compose.local.yaml stop",
    "build": "npm run build --workspace apps/web",
    "start": "npm run start --workspace apps/web",
    "lint": "npm run lint --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web",
    "test": "npm run test --workspace apps/web",
    "test:coverage": "npm run test:coverage --workspace apps/web",
    "test:e2e": "playwright test",
    "format": "prettier --write apps/web tests/e2e playwright.config.ts package.json .github/workflows/ci.yml",
    "format:check": "prettier --check apps/web tests/e2e playwright.config.ts package.json .github/workflows/ci.yml"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "prettier": "3.9.6"
  }
}
